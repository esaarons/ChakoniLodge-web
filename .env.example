# Número oficial de WhatsApp del establecimiento, formato internacional sin "+" ni espacios (ej. 51XXXXXXXXX).
# Si se deja vacío, el formulario de consulta funciona en modo demostración.
NEXT_PUBLIC_HOTEL_WHATSAPP=

# URL pública del sitio (para metadatos Open Graph y sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mantener en "false" mientras sea un prototipo sin autorización del establecimiento.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Reseñas de Google (Places API New). Variables solo de servidor: no usar el prefijo NEXT_PUBLIC_.
# Restringir la key a "Places API (New)" y, si es posible, por IP del servidor.
GOOGLE_MAPS_API_KEY=
# Place ID verificado del establecimiento (empieza por "ChIJ"). Obligatorio para las reseñas:
# sin GOOGLE_MAPS_API_KEY y GOOGLE_PLACE_ID no se hace ninguna solicitud a Google.
GOOGLE_PLACE_ID=

# Opcional: key de Maps Embed API para el mapa interactivo oficial. Es pública por naturaleza (va
# en el iframe): debe ser una key DISTINTA de GOOGLE_MAPS_API_KEY, restringida a Maps Embed API y al
# dominio. Sin ella se usa el embed por coordenadas. El mapa solo se carga tras un clic del visitante.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
